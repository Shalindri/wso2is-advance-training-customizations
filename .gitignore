# =============================================================================
# WSO2 IS customization labs - files that should never be committed
# =============================================================================

# -----------------------------------------------------------------------------
# Maven build output
#
# Everything under target/ is regenerated by "mvn clean install", including the
# .jar files you copy into the server. Committing it means every trainee's
# commits collide on recompiled .class files.
# -----------------------------------------------------------------------------
target/
.mvn/timing.properties
.flattened-pom.xml
dependency-reduced-pom.xml
pom.xml.versionsBackup
pom.xml.releaseBackup
pom.xml.next
pom.xml.tag
release.properties
buildNumber.properties

# Compiled output, wherever it lands
*.class
*.jar
*.war
*.ear
# Exception: if you ever add a Maven wrapper, its jar must be committed.
# This negation has to come AFTER *.jar - in .gitignore the last matching rule wins.
!.mvn/wrapper/maven-wrapper.jar

# -----------------------------------------------------------------------------
# IDEs
# -----------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# VS Code
.vscode/

# Eclipse
.classpath
.project
.settings/
# Note: Eclipse also builds into bin/. That is NOT ignored here, because "bin/"
# would also hide a genuine scripts folder. Add it yourself if you use Eclipse.

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# -----------------------------------------------------------------------------
# Operating system clutter
# Windows and macOS both drop hidden files into every folder they touch.
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# Word / Office lock files - these appear next to the .docx tutorials in docs/
# whenever somebody has one open. The .docx files themselves ARE committed.
~$*.doc*
~$*.xls*
~$*.ppt*
.~lock.*

# -----------------------------------------------------------------------------
# Things produced while running the labs
#
# These are runtime artifacts from testing, not part of the labs. They tend to
# appear if you run a lab from inside the project folder.
# -----------------------------------------------------------------------------
*.log
logs/
heap-dump.hprof
hs_err_pid*.log
replay_pid*.log

# H2 database files, if you create lab 05's database inside the project
*.mv.db
*.trace.db
*.lock.db

# Local Maven settings that may contain credentials.
# The maven-settings-central-only.xml that ships with the project has none and
# is committed on purpose - only personal copies are ignored.
settings-local.xml
settings.local.xml

# Local environment files
.env
.env.local
*.local

# -----------------------------------------------------------------------------
# Deliberately NOT ignored - these are project content, not build output:
#
#   docs/            the original .docx tutorials, their markdown conversions
#                    and the extracted screenshots
#   pdf/             the generated handouts. They are committed on purpose,
#                    because trainees on Windows cannot easily run
#                    make-pdfs.sh (it needs pandoc + Chrome)
#   *.sample, *.ps1, *.sh
#   maven-settings-central-only.xml
# -----------------------------------------------------------------------------
